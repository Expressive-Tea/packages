{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "paths": {
      "@classes": ["src/classes"],
      "@classes/*": ["src/classes/*"],
      "@decorators": ["src/decorators"],
      "@decorators/*": ["src/decorators/*"],
      "@helpers": ["src/helpers"],
      "@helpers/*": ["src/helpers/*"],
      "@types": ["src/types"],
      "@types/*": ["src/types/*"]
    }
  },
  "include": ["src/__test__/**/*"]
}
