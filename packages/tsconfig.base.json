{
  "compilerOptions": {
    "target": "ES2017",
    "module": "commonjs",
    "lib": ["ES2017"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "moduleResolution": "node",
    "removeComments": false,
    "allowJs": false,
    "baseUrl": ".",
    "paths": {
      "@classes": ["src/classes"],
      "@classes/*": ["src/classes/*"],
      "@decorators": ["src/decorators"],
      "@decorators/*": ["src/decorators/*"],
      "@exceptions": ["src/exceptions"],
      "@exceptions/*": ["src/exceptions/*"],
      "@helpers": ["src/helpers"],
      "@helpers/*": ["src/helpers/*"],
      "@interfaces": ["src/interfaces"],
      "@interfaces/*": ["src/interfaces/*"],
      "@types": ["src/types"],
      "@types/*": ["src/types/*"],
      "@libs": ["src/libs"],
      "@libs/*": ["src/libs/*"],
      "@constants": ["src/constants"],
      "@constants/*": ["src/constants/*"]
    }
  },
  "exclude": ["node_modules", "dist", "**/__test__"]
}
